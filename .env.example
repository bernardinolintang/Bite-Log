# Groq API key from https://console.groq.com — required for AI analysis
GROQ_API_KEY=
# Vision-capable model on Groq (must accept image input — check https://console.groq.com/docs/models)
GROQ_MODEL=qwen/qwen3.6-27b
# Local dev: file:local.db — production: Turso libsql:// URL
DATABASE_URL=file:local.db
# Only needed for Turso in production
DATABASE_AUTH_TOKEN=
# Day boundaries for the log, and the timezone the Telegram check-ins are scheduled in
APP_TIMEZONE=Asia/Singapore

# ---- Telegram bot (optional; the web app works without it) ----
# Token from @BotFather in Telegram. This is the only value you must paste by hand.
TELEGRAM_BOT_TOKEN=
# Your deployed https URL, no trailing slash — used to register the webhook
PUBLIC_URL=https://your-app.vercel.app
# Any long random string. Telegram sends it back on every update so others can't post fake ones.
TELEGRAM_WEBHOOK_SECRET=
# Any long random string. Guards the scheduled check-in endpoint.
CRON_SECRET=
